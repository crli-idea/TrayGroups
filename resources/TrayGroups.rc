#include <windows.h>
#include "../src/app/AppVersion.h"
1 ICON "TrayGroups.ico"
1 RT_MANIFEST "TrayGroups.manifest"
1 VERSIONINFO
FILEVERSION TRAYGROUPS_VERSION_NUMBERS
PRODUCTVERSION TRAYGROUPS_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "TrayGroups\0"
      VALUE "ProductName", "TrayGroups\0"
      VALUE "FileVersion", TRAYGROUPS_VERSION_TEXT "\0"
      VALUE "OriginalFilename", "TrayGroups.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

#pragma code_page(65001)
#include <commctrl.h>
#include "../src/ui/TraySettingsIds.h"


IDD_GROUPS DIALOGEX 0, 0, 498, 220
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "分组"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "选择图标，再为它分配一个组。Ctrl 可多选。", IDC_UI_SUBTITLE, 10, 9, 295, 11
    PUSHBUTTON "图标详情", IDC_ICON_DETAILS, 327, 5, 72, 17
    PUSHBUTTON "失效规则", IDC_MANAGE_RULES, 407, 5, 80, 17
    CONTROL "", IDC_ICON_LIST, WC_LISTVIEW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP, 10, 28, 477, 114
    GROUPBOX "分配到分组", -1, 10, 150, 477, 62
    LTEXT "组名", -1, 22, 167, 42, 11
    COMBOBOX IDC_GROUP, 73, 164, 298, 95, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "取消分组", IDC_UNGROUP, 382, 164, 92, 17
    LTEXT "作用范围", -1, 22, 191, 48, 11
    COMBOBOX IDC_SCOPE, 73, 188, 401, 75, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_ICON_DETAILS DIALOGEX 0, 0, 480, 310
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "图标详情"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "图标详情", IDC_UI_TITLE, 14, 10, 430, 22
    LTEXT "查看当前身份、匹配结果与显示状态，可选中文本复制。", IDC_UI_SUBTITLE, 15, 36, 450, 11
    EDITTEXT IDC_DETAIL_TEXT, 14, 56, 452, 215, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "关闭", IDOK, 392, 284, 74, 17
END

IDD_RULES DIALOGEX 0, 0, 540, 315
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "失效规则管理"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "失效规则", IDC_UI_TITLE, 12, 9, 515, 22
    LTEXT "程序未启动也可能导致失配。修改后，请返回设置点击应用。", IDC_UI_SUBTITLE, 13, 35, 514, 11
    CONTROL "", IDC_RULE_LIST, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 12, 55, 516, 128
    LTEXT "绑定到当前图标", -1, 12, 198, 95, 11
    COMBOBOX IDC_RULE_TARGET, 111, 195, 417, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "重新绑定", IDC_RULE_REBIND, 12, 223, 80, 17
    PUSHBUTTON "删除所选规则", IDC_RULE_DELETE, 100, 223, 90, 17
    PUSHBUTTON "刷新列表", IDC_RULE_REFRESH, 198, 223, 80, 17
    LTEXT "", IDC_RULE_STATUS, 12, 252, 516, 24
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 12, 281, 516, 1
    DEFPUSHBUTTON "确定", IDOK, 368, 291, 76, 17
    PUSHBUTTON "取消", IDCANCEL, 452, 291, 76, 17
END

IDD_APPEARANCE DIALOGEX 0, 0, 498, 220
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "外观"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    GROUPBOX "分组面板", -1, 10, 8, 477, 150
    LTEXT "面板宽度", -1, 22, 30, 80, 11
    EDITTEXT IDC_PANEL_WIDTH, 110, 27, 60, 17, ES_NUMBER | WS_TABSTOP
    LTEXT "340–600 逻辑像素", -1, 183, 30, 280, 11
    LTEXT "图标大小", -1, 22, 58, 80, 11
    EDITTEXT IDC_PANEL_ICON_SIZE, 110, 55, 60, 17, ES_NUMBER | WS_TABSTOP
    LTEXT "20–44 逻辑像素", -1, 183, 58, 280, 11
    LTEXT "每行图标", -1, 22, 86, 80, 11
    EDITTEXT IDC_PANEL_COLUMNS, 110, 83, 60, 17, ES_NUMBER | WS_TABSTOP
    LTEXT "3–6 个", -1, 183, 86, 280, 11
    AUTOCHECKBOX "显示图标名称", IDC_PANEL_NAMES, 22, 115, 190, 13
    AUTOCHECKBOX "显示底部截图区", IDC_PANEL_CAPTURE, 244, 115, 220, 13
    LTEXT "字体、组标题、颜色和按钮使用 Windows 系统样式。\n分组顺序仍可在 groups.ini 的 [GroupOrder] 中调整。", -1, 22, 173, 450, 30
END

IDD_CAPTURE DIALOGEX 0, 0, 498, 220
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "截图"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    GROUPBOX "定时截图", -1, 10, 8, 477, 147
    LTEXT "保存位置", -1, 22, 29, 70, 11
    EDITTEXT IDC_CAPTURE_DIRECTORY, 22, 45, 452, 17, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "文件名格式", -1, 22, 77, 80, 11
    EDITTEXT IDC_CAPTURE_FORMAT, 110, 74, 100, 17, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "HH-mm，例如 16-10.png", -1, 224, 77, 250, 11
    LTEXT "间隔（分钟）", -1, 22, 106, 80, 11
    EDITTEXT IDC_CAPTURE_INTERVAL, 110, 103, 60, 17, ES_NUMBER | WS_TABSTOP
    LTEXT "1–1440；按每天零点对齐", -1, 183, 106, 290, 11
    LTEXT "所有显示器合成一张 PNG，按日期分目录保存。", -1, 22, 132, 450, 12
    LTEXT "", IDC_CAPTURE_STATUS, 15, 167, 470, 13
    PUSHBUTTON "立即截图", IDC_CAPTURE_NOW, 15, 192, 80, 17
    PUSHBUTTON "打开保存目录", IDC_CAPTURE_FOLDER, 105, 192, 95, 17
END

IDD_ADVANCED DIALOGEX 0, 0, 498, 220
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "高级"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    GROUPBOX "图标识别", -1, 10, 8, 477, 74
    LTEXT "识别方式", -1, 22, 29, 58, 11
    COMBOBOX IDC_MATCH, 88, 26, 385, 75, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "优先使用程序路径与 GUID，无 GUID 时按窗口类别和编号识别。\n匹配不明确时保留原图标，重新选择图标并应用即可确认。", IDC_UI_SUBTITLE, 22, 49, 450, 25
    GROUPBOX "原图标折叠", -1, 10, 92, 477, 60
    AUTOCHECKBOX "隐藏已分组的原图标，退出时恢复", IDC_FOLD, 22, 110, 450, 13
    LTEXT "T 中只显示已隐藏的分组图标；隐藏失败时保留原图标。", -1, 22, 132, 450, 12
    GROUPBOX "维护", -1, 10, 162, 477, 50
    PUSHBUTTON "恢复全部图标", IDC_RESTORE_ALL, 22, 183, 95, 17
    PUSHBUTTON "资源占用", IDC_RESOURCES, 128, 183, 80, 17
    LTEXT "恢复本程序隐藏的图标", -1, 225, 187, 245, 11
END

IDD_ABOUT DIALOGEX 0, 0, 498, 220
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "关于"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    GROUPBOX "TrayGroups", -1, 10, 8, 477, 95
    ICON 1, IDC_UI_ICON, 24, 29, 20, 20
    LTEXT "", IDC_ABOUT_VERSION, 60, 29, 400, 14
    LTEXT "托盘图标分组与定时多屏截图", -1, 60, 51, 400, 12
    LTEXT "原生 Win32 系统控件界面", -1, 60, 72, 400, 12
    GROUPBOX "便携配置", -1, 10, 114, 477, 95
    LTEXT "分组：groups.ini；截图：config.json。\n配置放在程序目录下，升级时保留自己的配置。\n修改后点击应用保存；取消放弃尚未应用的修改。", -1, 22, 136, 450, 54
END
